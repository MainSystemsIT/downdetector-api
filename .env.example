DOWNDETECTOR_LOCALE=br # Suffixo do URL do Downdetector ".br"
BROWSER_LOCALE=pt-BR
CACHE_TTL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=90
HEADLESS=true
API_TOKEN=troque-este-token
# Opcional: use quando o IP do servidor for bloqueado pelo Cloudflare/Downdetector.
# DOWNDETECTOR_PROXY=http://usuario:senha@host:porta
# Opcional fora do Docker; nos compose files o valor é definido como /browser-data.
# BROWSER_USER_DATA_DIR=/browser-data

TRAEFIK_HOST=api.seudominio.com
